{
  "name": "invitation-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "docker compose up -d nginx && npx --yes kill-port 3000 && node -e \"require('fs').rmSync('.next/dev',{recursive:true,force:true})\" && next dev",
    "dev:https": "next dev --experimental-https --experimental-https-key nginx/certs/localhost.key --experimental-https-cert nginx/certs/localhost.crt",
    "nginx:up": "docker compose up -d nginx",
    "nginx:down": "docker compose stop nginx",
    "nginx:logs": "docker compose logs -f nginx",
    "dev:next": "next dev",
    "dev:nginx": "docker compose up -d nginx && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:restart": "docker compose restart",
    "db:logs": "docker logs invitation-platform-postgres",
    "db:status": "docker ps",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "adm-zip": "^0.6.0",
    "framer-motion": "^12.42.2",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.26.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "postcss": "^8.5.23",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
